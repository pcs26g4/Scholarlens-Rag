# Copy this file to .env in this directory (rag_mm/) and fill in real values.
# Never commit the real .env -- it holds API keys.

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
COLLECTION_NAME=student_validator_qa

# --- Embeddings ---
EMBED_MODEL=all-MiniLM-L6-v2
# sentence_transformers (default) or llama_index_hf
EMBED_BACKEND=sentence_transformers

# --- Retrieval ---
TOP_K=2
SIMILARITY_THRESHOLD=0.8

# --- LLM provider ---
# openrouter or gemini -- see README "Switching LLM provider / model"
LLM_PROVIDER=openrouter

# Used when LLM_PROVIDER=openrouter
LLM_PROVIDER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-3.5-turbo-1106
OPENROUTER_API_KEY=your-openrouter-api-key

# Used when LLM_PROVIDER=gemini instead:
# LLM_MODEL=gemini-2.5-pro
# GEMINI_API_KEY=your-gemini-api-key

# Hard wall-clock cap (seconds) per LLM call (verdict or eval). requests'
# own timeout= only resets each time a byte arrives from the server, so a
# provider that trickles keep-alive data while a model is still generating
# can run far past that without erroring -- this is an independent,
# always-enforced deadline that fires regardless of what the network layer
# is doing underneath.
LLM_CALL_TIMEOUT_SECONDS=150

# Sampling temperature for the verdict model, 0 = least random (picks the
# most likely wording/judgment every time instead of sampling), reducing
# run-to-run variation in wording and even in the assigned grade for
# identical input. Not an ironclad determinism guarantee, but a large
# reduction in variance versus the provider's own default (usually >0).
LLM_TEMPERATURE=0

# --- Weakness-evaluation layer ---
# After a verdict is generated, a second ("checker") LLM call scores whether
# the Weaknesses section is grounded (not hallucinated) and applicable (not
# penalizing the answer for something the question never required). If the
# score is below EVAL_THRESHOLD, the verdict is regenerated with the
# checker's critique folded in, up to EVAL_MAX_ATTEMPTS total tries; the
# highest-scoring attempt is returned either way.
EVAL_THRESHOLD=0.90
EVAL_MAX_ATTEMPTS=3

# Checker's own provider/model/temperature -- each optional, falls back to
# the matching LLM_* / *_API_KEY setting above when unset, so this works
# with zero extra config (checker == verdict model) until you want them to
# differ.
# EVAL_LLM_PROVIDER=gemini
# EVAL_LLM_MODEL=gemini-2.5-pro
# EVAL_LLM_PROVIDER_BASE_URL=https://openrouter.ai/api/v1
# EVAL_OPENROUTER_API_KEY=your-openrouter-api-key
# EVAL_GEMINI_API_KEY=your-gemini-api-key
EVAL_LLM_TEMPERATURE=0

# --- Short-feedback summarization layer ---
# After a verdict is resolved (threshold met or best-of-3 fallback), a
# third, independent model call compresses the long feedback (strengths +
# weaknesses + verdict/marks) into a short, crisp, plain-English summary.
# This is a distinct role from both the verdict and eval models -- it does
# NOT fall back to LLM_MODEL/EVAL_LLM_MODEL, it defaults to GPT-4o via
# OpenRouter regardless of whatever verdict/eval models are configured
# above, and is only ever called once per request (not once per attempt).
SUMMARY_LLM_PROVIDER=openrouter
SUMMARY_LLM_MODEL=openai/gpt-4o
# SUMMARY_LLM_PROVIDER_BASE_URL=https://openrouter.ai/api/v1
# SUMMARY_OPENROUTER_API_KEY=your-openrouter-api-key
# SUMMARY_GEMINI_API_KEY=your-gemini-api-key
SUMMARY_LLM_TEMPERATURE=0
